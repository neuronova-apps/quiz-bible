{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronova-apps.github.io/quizbible-app/data/question.schema.json",
  "title": "Quiz Bible Question",
  "description": "Contrato de datos para una pregunta editorial de Quiz Bible.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "language",
    "category",
    "difficulty",
    "contentType",
    "prompt",
    "options",
    "correctOptionId",
    "explanation",
    "references",
    "tags",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^qb-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "approved", "retired"]
    },
    "language": {
      "const": "es"
    },
    "category": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "contentType": {
      "type": "string",
      "enum": ["textual_fact", "contextual"]
    },
    "prompt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 240
    },
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-d]$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "correctOptionId": {
      "type": "string",
      "pattern": "^[a-d]$"
    },
    "explanation": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book", "chapter", "verseStart", "display"],
      "properties": {
        "book": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "chapter": {
          "type": "integer",
          "minimum": 1
        },
        "verseStart": {
          "type": "integer",
          "minimum": 1
        },
        "verseEnd": {
          "type": "integer",
          "minimum": 1
        },
        "display": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80
        },
        "translation": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceChecked",
        "singleCorrectAnswerChecked",
        "doctrinalSensitivity",
        "notes"
      ],
      "properties": {
        "referenceChecked": {
          "type": "boolean"
        },
        "singleCorrectAnswerChecked": {
          "type": "boolean"
        },
        "doctrinalSensitivity": {
          "type": "string",
          "enum": ["none", "possible"]
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
